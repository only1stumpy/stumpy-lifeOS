# Stumpy LifeOS: переменные окружения. Полное описание — docs/configuration.md.
# Локально скопируйте файл в .env (или .env.local: он приоритетнее .env). Значения секретов не коммитьте.
# На Vercel те же имена задаются в Settings -> Environment Variables (Production и, при необходимости, Preview).

# ---------------------------------------------------------------------------
# Обязательные
# ---------------------------------------------------------------------------

# Строка подключения Neon PostgreSQL (обязательна: без неё приложение показывает заглушку, API отвечают 503).
DATABASE_URL=

# Токен бота от BotFather (обязателен: проверка подписи initData Mini App и ответы бота).
TELEGRAM_BOT_TOKEN=

# Секрет webhook Telegram (обязателен). Допустимы символы A-Z a-z 0-9 _ - ; рекомендуется не короче 32 символов.
# Пример генерации: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Секрет защиты /api/cron (обязателен для плановых задач). Рекомендуется не короче 32 символов.
# cron-job.org передаёт его заголовком Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Ключ шифрования API-ключей ИИ пользователей: 32 случайных байта в base64 (обязателен для сохранения ключей ИИ).
# Генерация: openssl rand -base64 32
# Потеря или замена ключа делает сохранённые ключи ИИ нечитаемыми (ротации в коде нет, см. docs/operations.md).
AI_PROVIDER_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Необязательные
# ---------------------------------------------------------------------------

# Публичный HTTPS-адрес развёртывания без пути, например https://lifeos.example.com.
# Нужен для npm run telegram:register и для кнопки «Открыть LifeOS» в боте.
APP_URL=

# Telegram ID владельца развёртывания. Нужен для резервных копий (npm run backup:export / backup:restore)
# и для просмотра метрик квот Gemini в Mini App. Обычным пользователям не требуется.
TELEGRAM_OWNER_ID=

# Время ежедневной и недельной сводки по умолчанию (HH:MM, по часовому поясу пользователя).
# Пользователь может задать своё время в настройках. По умолчанию 19:30.
DAILY_SUMMARY_TIME=19:30
WEEKLY_SUMMARY_TIME=19:30
# Окно доставки сводки после этого времени, минут. 30 — под cron каждые 30 минут; 1440 — под вызов раз в сутки.
# SUMMARY_WINDOW_MINUTES=30

# Метрики квот Gemini для владельца через Google Cloud Monitoring (все три поля необязательны).
# Название модели для панели квот; по умолчанию gemini-3.5-flash-lite.
GEMINI_MODEL=
# JSON сервисного аккаунта с ролью roles/monitoring.viewer одной строкой. Только в Production, в чат и репозиторий не передавать.
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
# Идентификатор проекта Google Cloud; если пусто, берётся project_id из JSON сервисного аккаунта.
GOOGLE_CLOUD_PROJECT_ID=

# ---------------------------------------------------------------------------
# Не задавать в production
# ---------------------------------------------------------------------------
# Ключи ИИ задаёт каждый пользователь в Mini App (BYOK), они хранятся в базе зашифрованными.
# GEMINI_API_KEY, GROQ_API_KEY, GROQ_MODEL и LIFEOS_ALLOW_ENV_AI_KEYS используются только тестами
# (tests/setup.ts); в работающем приложении ключи окружения не применяются.
# NEXT_PUBLIC_APP_VERSION и NEXT_PUBLIC_RELEASE_HISTORY выставляет next.config.ts из package.json и CHANGELOG.md.

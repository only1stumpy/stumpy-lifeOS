# Required for persistent storage and Telegram integration.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
# Optional legacy single-user account for deployment-wide provider keys and Gemini quota metrics.
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional cloud analysis. Calls must remain within each provider's free quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: read Gemini quota metrics from the Google Cloud project used by the API key.
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT_ID=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Required to save per-user BYOK credentials; generate with `openssl rand -base64 32`.
AI_PROVIDER_ENCRYPTION_KEY=

# Required to protect cron-triggered summary routes.
CRON_SECRET=
DAILY_SUMMARY_TIME=19:30
WEEKLY_SUMMARY_TIME=19:30

# Optional public URL used to register Telegram's webhook.
APP_URL=

# Required for persistent storage and Telegram integration.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
# Optional Telegram ID allowed to see deployment Gemini quota metrics.
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

# AI keys are added by each user in the Mini App and stored encrypted in the database.
# Optional: Gemini quota metrics from a Google Cloud project.
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT_ID=
# Required to save per-user BYOK credentials; generate with `openssl rand -base64 32`.
AI_PROVIDER_ENCRYPTION_KEY=

# Required to protect cron-triggered summary routes.
CRON_SECRET=
DAILY_SUMMARY_TIME=19:30
WEEKLY_SUMMARY_TIME=19:30

# Optional public URL used to register Telegram's webhook.
APP_URL=

{
  "name": "lifeos-promo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "audio": "node scripts/make-audio.mjs",
    "render": "remotion render src/index.ts Promo out/lifeos-promo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=4",
    "poster": "remotion still src/index.ts Promo out/poster.png --frame=290",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.544",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.544"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
